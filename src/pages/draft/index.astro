---
import DraftDiff from "../../components/DraftDiff.astro";
import Shell from "../../layouts/Shell.astro";
import { getViewState } from "../../lib/view";

const v = getViewState(Astro.url);
const draft = v.draft;
---

<Shell title="Draft" view={v}>
  <div class="pagehead">
    <h1>Draft</h1>
    <p>Try changes in a private copy of your timetable. Nothing real changes until you apply it.</p>
  </div>
  {
    !draft ? (
      <section class="block" aria-labelledby="d-start">
        <h2 id="d-start">Start a draft</h2>
        <form method="post" action="/api/draft/new" class="form" style="margin-top:12px">
          <div class="field">
            <label for="draft-name">Name (optional)</label>
            <input id="draft-name" name="name" type="text" maxlength="60" autocomplete="off" />
          </div>
          <div class="row"><button class="btn solid" type="submit">Start a draft</button></div>
        </form>
      </section>
    ) : (
      <div class="stack">
        <DraftDiff catalog={v.catalog} term={v.term} real={v.realAlloc} draftAlloc={v.alloc} seats={v.seats} draftId={draft.id} name={draft.name} />
        <div class="row">
          <form method="post" action="/api/draft/apply">
            <input type="hidden" name="draftId" value={draft.id} />
            <button class="btn solid" type="submit">Apply to my timetable</button>
          </form>
          <details class="confirmx">
            <summary class="btn quiet">Discard draft</summary>
            <div class="confirmx-body">
              <p>Discard “{draft.name}”? You can undo straight after.</p>
              <form method="post" action="/api/draft/discard">
                <input type="hidden" name="draftId" value={draft.id} />
                <button class="btn danger small" type="submit">Discard it</button>
              </form>
            </div>
          </details>
        </div>
      </div>
    )
  }
</Shell>
