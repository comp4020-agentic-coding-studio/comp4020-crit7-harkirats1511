---
// The List view: every class you hold, per course, with its time, weeks and room. Secondary to My week.
import Icon from "../../components/Icon.astro";
import Shell from "../../layouts/Shell.astro";
import * as D from "../../lib/daybook";
import { clashesFor } from "../../lib/engine/clash";
import { getViewState } from "../../lib/view";

const view = getViewState(Astro.url);
const { catalog, alloc, draft } = view;
const courses = [...catalog.courses.values()].sort((a, b) => a.code.localeCompare(b.code));
const clashText = (optionId: string) =>
  clashesFor(optionId, alloc, catalog).map((c) => {
    const o = c.overlaps[0];
    return `Clashes with your ${D.className(catalog, c.groupB)}, ${D.DAY_SHORT[o.day]} ${D.range12(o.fromMin, o.toMin)}`;
  });
---

<Shell title="List of classes" view={view}>
  <div class="pagehead">
    <h1>Your classes</h1>
    <ul class="tabs" aria-label="View">
      <li><a href="/">My week</a></li>
      <li><a href="/timetable/" aria-current="page">List</a></li>
    </ul>
  </div>
  <div class="stack">
    {
      courses.map((c) => (
        <section class="block" aria-labelledby={`c-${c.id}`}>
          <div class="block-head">
            <h2 id={`c-${c.id}`}>
              <span class={`tag ${D.courseHue(catalog, c.id)}`}>{c.code}</span> {c.title}
            </h2>
          </div>
          <div class="table-wrap">
            <table class="data stackable">
              <caption class="sr">{c.code} classes you hold</caption>
              <thead>
                <tr>
                  <th scope="col">Class</th>
                  <th scope="col">When</th>
                  <th scope="col">Weeks</th>
                  <th scope="col">Room</th>
                  <th scope="col"><span class="sr">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                {c.groups.map((g) => {
                  const oid = alloc.get(g.id);
                  const o = oid ? catalog.options.get(oid) : undefined;
                  const change = `/course/${encodeURIComponent(c.code)}/?group=${encodeURIComponent(g.id)}`;
                  if (!o) {
                    return (
                      <tr>
                        <th scope="row">{D.kindWord(g)}</th>
                        <td colspan="3" class="muted">Not chosen yet</td>
                        <td class="actions"><a class="btn small" href={change}>Choose</a></td>
                      </tr>
                    );
                  }
                  const slots = D.toSlots(o.sessions, g).filter((s) => !s.optional || g.exemptFromClash);
                  const clashes = clashText(o.id);
                  const canChange = D.realOptions(g).length > 1;
                  return (
                    <tr class:list={{ "has-clash": clashes.length > 0 }}>
                      <th scope="row">{D.kindWord(g)}{g.exemptFromClash && <span class="s">Optional</span>}</th>
                      <td>
                        {slots.map((s) => (
                          <span class="nowrap" style="display:block">
                            {D.DAY_SHORT[s.day]} <time datetime={D.hhmm(s.start)}>{D.range12(s.start, s.end)}</time>
                            {s.tailEnd !== null && <span class="s">+ optional drop-in {D.range12(s.end, s.tailEnd)}</span>}
                          </span>
                        ))}
                        {clashes.map((t) => (
                          <span class="clashline"><Icon name="alert" />{t}</span>
                        ))}
                      </td>
                      <td>{slots.map((s) => <span style="display:block">{D.weeksWords(s.weeks)}</span>)}</td>
                      <td>{slots[0]?.room ?? <span class="muted">Not published</span>}</td>
                      <td class="actions">
                        {canChange && <a class="btn small" href={change} aria-label={`Change your ${c.code} ${D.kindWord(g).toLowerCase()}`}>Change</a>}
                        <details class="confirmx">
                          <summary class="btn quiet small" aria-label={`Drop your ${c.code} ${D.kindWord(g).toLowerCase()}`}>Drop</summary>
                          <div class="confirmx-body">
                            <p>Drop your {c.code} {D.kindWord(g).toLowerCase()}? You can undo straight after.</p>
                            <form method="post" action="/api/drop">
                              <input type="hidden" name="groupId" value={g.id} />
                              {draft && <input type="hidden" name="draftId" value={draft.id} />}
                              <input type="hidden" name="next" value="/timetable/" />
                              <button class="btn danger small" type="submit">Drop it</button>
                            </form>
                          </div>
                        </details>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      ))
    }
  </div>
  <p style="margin-top:20px">
    <a class="btn quiet" href="/api/timetable.ics" download><Icon name="cal" />Add to my calendar (.ics)</a>
  </p>
</Shell>
