---
import HistoryList from "../../components/HistoryList.astro";
import Shell from "../../layouts/Shell.astro";
import { DEFAULT_STUDENT_ID, loadHistory } from "../../lib/services/alloc";
import { getViewState } from "../../lib/view";

const v = getViewState(Astro.url);
const batches = loadHistory(DEFAULT_STUDENT_ID, 100);
---

<Shell title="History" view={v}>
  <div class="pagehead">
    <h1>History</h1>
    <p>Every change, newest first. You can undo the newest one.</p>
  </div>
  <HistoryList batches={batches} catalog={v.catalog} />
</Shell>
