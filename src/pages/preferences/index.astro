---
import PrefsForm from "../../components/PrefsForm.astro";
import { plural } from "../../components/h-format";
import Shell from "../../layouts/Shell.astro";
import { scorePrefs } from "../../lib/engine/prefs";
import { twelveHour } from "../../lib/daybook";
import { getViewState } from "../../lib/view";

const v = getViewState(Astro.url);
const score = scorePrefs(v.realAlloc, v.catalog, v.prefs);
const KIND: Record<string, string> = { dayOff: "Day off", early: "Early start", late: "Late finish", gap: "Long gap", walk: "Building change" };
---

<Shell title="Preferences" view={v}>
  <div class="pagehead">
    <h1>Preferences</h1>
    <p>What a good week looks like to you. Auto-fix uses this to choose between fixes; it never allows a clash.</p>
  </div>
  <div class="stack">
    <PrefsForm prefs={v.prefs} />
    <section class="block" aria-labelledby="p-score">
      <h2 id="p-score">Your timetable scores {score.total}</h2>
      {
        score.penalties.length === 0 ? (
          <p>It meets every preference you set.</p>
        ) : (
          <>
            <p>{plural(score.penalties.length, "thing adds", "things add")} points (lower is better).</p>
            <div class="table-wrap" style="margin-top:10px">
              <table class="data">
                <caption class="sr">Points and why</caption>
                <thead><tr><th scope="col">Kind</th><th scope="col">Points</th><th scope="col">Why</th></tr></thead>
                <tbody>
                  {score.penalties.map((p) => (
                    <tr><th scope="row">{KIND[p.kind]}</th><td>+{p.points}</td><td>{twelveHour(p.detail)}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )
      }
      {v.draft && <p class="muted">Scored on your real timetable, not the draft.</p>}
    </section>
  </div>
</Shell>
