---
import Shell from "../layouts/Shell.astro";

// Must stay SSR (never prerender). Deploy CI POSTs to `/`: a same-origin POST must not 403 and a cross-origin
// POST must 403 (Astro's CSRF check runs before this). This benign handler just redirects.
if (Astro.request.method === "POST") {
  return Astro.redirect("/", 303);
}
---

<Shell title="Dashboard">
  <h1>Dashboard</h1>
</Shell>
