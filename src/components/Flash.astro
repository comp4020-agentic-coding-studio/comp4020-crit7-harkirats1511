---
import { errorText, msgText } from "../lib/view";
interface Props {
  msg?: string | null;
  error?: string | null;
  detail?: string | null;
}
const { msg, error, detail } = Astro.props;
---

{
  error ? (
    <div class="flash flash-error" role="alert">
      <svg class="ico" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1 11.5 11h-11z" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M6 4.5v3M6 9v.01" stroke="currentColor" stroke-width="1.5" /></svg>
      <p><strong>Not done.</strong> {errorText(error)} {detail && <span>{detail}</span>}</p>
    </div>
  ) : msg ? (
    <div class="flash flash-ok" role="status">
      <svg class="ico" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6.5 5 9.5 10.5 3" fill="none" stroke="currentColor" stroke-width="2" /></svg>
      <p>{msgText(msg)}</p>
    </div>
  ) : null
}
