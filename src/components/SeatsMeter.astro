---
// Seats left. capacity null = "Not published" (never zero, never full).
interface Props {
  capacity: number | null;
  left: number | null;
}
const { capacity, left } = Astro.props;
const big = capacity !== null && capacity >= 200;
const taken = capacity && left !== null ? Math.min(100, Math.round(((capacity - left) / capacity) * 100)) : 0;
---

{
  capacity === null || left === null ? (
    <span class="seats seats-unknown">Not published</span>
  ) : big ? (
    <span class="seats">Plenty <span class="seats-of">(cap {capacity})</span></span>
  ) : (
    <span class:list={["seats", { "seats-none": left === 0 }]}>
      <span class="seats-num">{left} left</span> <span class="seats-of">of {capacity}</span>
      <span class="seats-bar" aria-hidden="true"><span style={`width:${taken}%`} /></span>
    </span>
  )
}
