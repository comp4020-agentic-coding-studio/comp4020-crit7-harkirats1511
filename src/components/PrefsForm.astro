---
import type { Prefs } from "../lib/engine/types";

interface Props { prefs: Prefs }
const { prefs } = Astro.props;
const DAYS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
const hhmm = (m: number | null) => (m === null ? "" : `${String(Math.floor(m / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`);
const weights: [string, string, number, string][] = [
  ["weightDayOff", "Day off", prefs.weights.dayOff, "per class on a day off"],
  ["weightEarly", "Early start", prefs.weights.early, "per 30 min before your earliest start"],
  ["weightLate", "Late finish", prefs.weights.late, "per 30 min after your latest end"],
  ["weightGap", "Long gap", prefs.weights.gap, "per 30 min over your longest gap"],
  ["weightWalk", "Building change", prefs.weights.walk, "per rushed walk between buildings"],
];
---

<form method="post" action="/api/prefs" class="form" id="prefs-form">
  <fieldset class="fs">
    <legend>Days off</legend>
    {DAYS.map((d, i) => (
      <span class="check">
        <input type="checkbox" id={`day-${i}`} name="daysOff" value={String(i)} checked={prefs.daysOff.includes(i as any)} />
        <label for={`day-${i}`}>{d}</label>
      </span>
    ))}
  </fieldset>

  <fieldset class="fs">
    <legend>Times</legend>
    <p class="hint">Leave a box empty for no preference.</p>
    <div class="fields" style="margin-top:10px">
      <div class="field"><label for="earliestStart">Earliest start</label><input id="earliestStart" name="earliestStart" type="time" value={hhmm(prefs.earliestStartMin)} /></div>
      <div class="field"><label for="latestEnd">Latest end</label><input id="latestEnd" name="latestEnd" type="time" value={hhmm(prefs.latestEndMin)} /></div>
      <div class="field"><label for="maxGapMin">Longest gap (min)</label><input id="maxGapMin" name="maxGapMin" type="number" min="0" step="1" inputmode="numeric" value={prefs.maxGapMin ?? ""} /></div>
      <div class="field"><label for="minWalkGapMin">Walk between buildings (min)</label><input id="minWalkGapMin" name="minWalkGapMin" type="number" min="0" step="1" inputmode="numeric" value={prefs.minWalkGapMin ?? ""} /></div>
    </div>
  </fieldset>

  <fieldset class="fs">
    <legend>How much each matters</legend>
    <p class="hint">0 switches one off.</p>
    <div class="fields" style="margin-top:10px">
      {weights.map(([name, label, value, hint]) => (
        <div class="field">
          <label for={name}>{label}</label>
          <input id={name} name={name} type="number" min="0" step="any" inputmode="decimal" value={value} aria-describedby={`${name}-hint`} />
          <span class="hint" id={`${name}-hint`}>{hint}</span>
        </div>
      ))}
    </div>
  </fieldset>

  <div class="row">
    <button class="btn solid" type="submit">Save preferences</button>
    <button class="btn quiet" type="submit" name="reset" value="1" formnovalidate>Reset to defaults</button>
  </div>
</form>
