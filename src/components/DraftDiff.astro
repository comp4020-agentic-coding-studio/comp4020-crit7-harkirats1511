---
// Draft vs real, per changed class, plus the clash count before and after and a seats warning.
import { allClashes } from "../lib/engine/clash";
import { diffAlloc } from "../lib/engine/draft";
import type { Allocation, Catalog, SeatsUsed, Term } from "../lib/engine/types";
import Icon from "./Icon.astro";
import { courseHref, groupLabel, optionCode, plural } from "./h-format";

interface Props {
  catalog: Catalog;
  term: Term;
  real: Allocation;
  draftAlloc: Allocation;
  seats: SeatsUsed;
  draftId: string;
  name: string;
}
const { catalog, real, draftAlloc, seats, draftId, name } = Astro.props;

const moves = diffAlloc(real, draftAlloc);
const realClashes = allClashes(real, catalog).length;
const draftClashes = allClashes(draftAlloc, catalog).length;
const full = (optionId: string | null) => {
  if (!optionId) return false;
  const o = catalog.options.get(optionId);
  return !!o && o.capacity !== null && (seats.get(optionId) ?? 0) >= o.capacity;
};
const fullMoves = moves.filter((m) => full(m.toOptionId));
---

<section class:list={["block", { good: draftClashes === 0, warn: draftClashes > 0 }]} aria-labelledby="d-diff">
  <div class="block-head">
    <h2 id="d-diff">“{name}”</h2>
    <span class="sub">{plural(moves.length, "change")}</span>
  </div>
  <p>
    {draftClashes === 0 ? "No clashes in this draft" : `${plural(draftClashes, "clash", "clashes")} in this draft`}
    {" "}(your timetable has {realClashes === 0 ? "none" : realClashes}).
  </p>
  {
    fullMoves.length > 0 && (
      <p class="clashline" role="alert">
        <Icon name="alert" />
        Full right now, so applying will fail until a seat opens: {fullMoves.map((m) => `${groupLabel(catalog, m.groupId)} ${optionCode(catalog, m.toOptionId)}`).join(", ")}.
      </p>
    )
  }
  {
    moves.length === 0 ? (
      <p>No changes yet. Pick new times from <a href="/change/">Change a class</a>; they go into this draft.</p>
    ) : (
      <div class="table-wrap" style="margin-top:12px">
        <table class="data stackable">
          <caption class="sr">Changes in this draft</caption>
          <thead>
            <tr><th scope="col">Class</th><th scope="col">Now</th><th scope="col">In the draft</th></tr>
          </thead>
          <tbody>
            {moves.map((m) => (
              <tr>
                <th scope="row"><a href={courseHref(catalog, m.groupId, draftId)}>{groupLabel(catalog, m.groupId)}</a></th>
                <td>{optionCode(catalog, m.fromOptionId, "Not enrolled")}</td>
                <td>{optionCode(catalog, m.toOptionId, "Dropped")}{full(m.toOptionId) && <> <span class="chipfull">Full</span></>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</section>
