---
// Teaching-week label ("Wks 2-6, 7-12"); the mid-sem break sits between the runs that straddle it.
import { formatWeeks } from "../lib/engine/weeks";
interface Props {
  mask: number;
  breakAfterWeek?: number | null;
}
const { mask, breakAfterWeek = null } = Astro.props;
const text = formatWeeks(mask, breakAfterWeek);
---

<span class="weeks">{text || "No weeks"}</span>
