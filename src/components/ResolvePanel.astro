---
// Resolve panel for /course/<CODE>/?pick=<optionId>: two clearly separated ways out of a clash.
import { resolveClash } from "../lib/engine/resolve";
import type { Candidate, Course } from "../lib/engine/types";
import { clashWhen, DAY_NAMES, fmtRange, optionFullName, optionName, type ViewState } from "../lib/view";
import SeatsMeter from "./SeatsMeter.astro";
import StateChip from "./StateChip.astro";
import WeeksLabel from "./WeeksLabel.astro";
interface Props {
  course: Course;
  optionId: string;
  view: ViewState;
}
const { course, optionId, view } = Astro.props;
const { catalog, term, alloc, seats, draft } = view;
const plan = resolveClash(optionId, alloc, catalog, seats);
const groupA = catalog.groups.get(plan.groupId)!;
const optA = catalog.options.get(optionId)!;
const nameA = `${groupA.name} ${optA.code}`;
const currentA = alloc.get(plan.groupId) ?? null;

const whenParts = (id: string) => catalog.options.get(id)!.sessions.map((s) => `${DAY_NAMES[s.day]} ${fmtRange(s)}`);
const when = (id: string) => whenParts(id).join(" + ");
const weeksOf = (id: string) => catalog.options.get(id)!.sessions[0]?.weeks ?? 0;
const usable = (c: Candidate) => c.safe && !c.full;
const why = (c: Candidate): { kind: "full" | "clash"; text: string }[] => {
  const out: { kind: "full" | "clash"; text: string }[] = [];
  if (c.full) out.push({ kind: "full", text: "Full, no seats left" });
  for (const n of c.newClashes) out.push({ kind: "clash", text: `Would clash with ${optionFullName(catalog, n.optionB)} (${clashWhen(n, term)})` });
  return out;
};
const alt = plan.alternatives;
const altUsable = alt.filter(usable);
const bmoves = plan.blockerMoves;
---

<section class="panel resolve" aria-labelledby="resolve-h">
  <div class="panel-head"><h2 id="resolve-h">Resolve clash</h2><a href={`/course/${course.code}/`}>Cancel</a></div>
  <div class="panel-body">
    {
      plan.clashes.length === 0 ? (
        <>
          <p>
            <StateChip kind="ok" /> <strong>{nameA}</strong> does not clash with anything in your {draft ? "draft " : ""}timetable
            {currentA === optionId ? ". You already hold it." : "."}
          </p>
          {currentA !== optionId && (
            <form method="post" action="/api/select" class="inline-form">
              <input type="hidden" name="optionId" value={optionId} />
              {draft && <input type="hidden" name="draftId" value={draft.id} />}
              <input type="hidden" name="next" value={`/course/${course.code}/`} />
              <button class="btn btn-primary" type="submit">Select {nameA}</button>
            </form>
          )}
        </>
      ) : (
        <>
          {plan.clashes.map((c) => (
            <p class="resolve-summary">
              <StateChip kind="clash" /> You picked <strong>{nameA}</strong> but it clashes with{" "}
              <strong>{optionFullName(catalog, c.optionB)}</strong> ({clashWhen(c, term)}).
            </p>
          ))}

          <section class="way" aria-labelledby="way1">
            <h3 id="way1"><span class="way-n">1</span> Choose a different time for this activity</h3>
            <p class="way-lead">
              {
                alt.length === 0
                  ? `No other times exist for ${course.code} ${groupA.name}.`
                  : altUsable.length === 0
                    ? `None of the ${alt.length} other times for ${groupA.name} can be taken: each is full or clashes with something else.`
                    : `${altUsable.length} of ${alt.length} other times for ${groupA.name} are clash-free and have a seat.`
              }
            </p>
            {alt.length > 0 && (
              <div class="table-wrap" tabindex="0" role="group" aria-label={`Other times for ${groupA.name}`}>
                <table class="data stack">
                  <caption class="sr-only">Other times for {groupA.name}</caption>
                  <thead>
                    <tr><th scope="col">Option</th><th scope="col">When</th><th scope="col">Teaching weeks</th><th scope="col">Seats left</th><th scope="col">Action</th></tr>
                  </thead>
                  <tbody>
                    {alt.map((c) => (
                      <tr class:list={{ unusable: !usable(c) }}>
                        <th scope="row">{groupA.name} {catalog.options.get(c.optionId)?.code}</th>
                        <td data-label="When">{whenParts(c.optionId).map((w) => <div class="nowrap">{w}</div>)}</td>
                        <td data-label="Teaching weeks"><WeeksLabel mask={weeksOf(c.optionId)} breakAfterWeek={term.breakAfterWeek} /></td>
                        <td data-label="Seats left"><SeatsMeter capacity={catalog.options.get(c.optionId)?.capacity ?? null} left={c.seatsLeft} /></td>
                        <td class="actions" data-label="Action">
                          {usable(c) ? (
                            <form method="post" action="/api/select">
                              <input type="hidden" name="optionId" value={c.optionId} />
                              {draft && <input type="hidden" name="draftId" value={draft.id} />}
                              <input type="hidden" name="next" value={`/course/${course.code}/`} />
                              <button class="btn btn-primary" type="submit">Select {optionName(catalog, c.optionId)}</button>
                            </form>
                          ) : (
                            <>
                              <button class="btn" type="button" disabled>Unavailable</button>
                              {why(c).map((w) => <div class="why"><StateChip kind={w.kind} /> {w.text}</div>)}
                            </>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>

          <section class="way" aria-labelledby="way2">
            <h3 id="way2"><span class="way-n">2</span> Move the class it clashes with</h3>
            {bmoves.length > 1 && (
              <p class="way-lead">It clashes with {bmoves.length} classes. All of them must move, so a single move below will be refused if another blocker remains.</p>
            )}
            {bmoves.map((b) => {
              const gB = catalog.groups.get(b.groupId)!;
              const cB = catalog.courses.get(gB.courseId)!;
              const cands = b.candidates;
              const ok = cands.filter(usable);
              const nameB = optionFullName(catalog, b.currentOptionId);
              const moves = (to: string) =>
                JSON.stringify([
                  { groupId: b.groupId, fromOptionId: b.currentOptionId, toOptionId: to },
                  { groupId: plan.groupId, fromOptionId: currentA, toOptionId: optionId },
                ]);
              const nFull = cands.filter((c) => c.full).length;
              const nClash = cands.filter((c) => !c.safe).length;
              return (
                <div class="blocker" id={`blocker-${b.groupId}`} data-group={b.groupId}>
                  <h4>Move {nameB} ({when(b.currentOptionId)}) to another time</h4>
                  <p class="way-lead">
                    {
                      cands.length === 0
                        ? `No other times exist for ${cB.code} ${gB.name}, so it cannot move.`
                        : ok.length === 0
                          ? `None of the ${cands.length} other times for ${cB.code} ${gB.name} can be used${
                              nFull === cands.length
                                ? ": all are full."
                                : nClash === cands.length
                                  ? ": all would clash with something else."
                                  : `: ${nFull} full, ${nClash} would clash.`
                            }`
                          : `${ok.length} of ${cands.length} other times are safe. Moving it then selects ${nameA} in one step.`
                    }
                  </p>
                  {cands.length > 0 && (
                    <div class="table-wrap" tabindex="0" role="group" aria-label={`Other times for ${cB.code} ${gB.name}`}>
                      <table class="data stack">
                        <caption class="sr-only">Other times for {cB.code} {gB.name}</caption>
                        <thead>
                          <tr><th scope="col">Move to</th><th scope="col">When</th><th scope="col">Teaching weeks</th><th scope="col">Seats left</th><th scope="col">Action</th></tr>
                        </thead>
                        <tbody>
                          {cands.map((c) => (
                            <tr class:list={{ unusable: !usable(c) }}>
                              <th scope="row">{gB.name} {catalog.options.get(c.optionId)?.code}</th>
                              <td data-label="When">{whenParts(c.optionId).map((w) => <div class="nowrap">{w}</div>)}</td>
                              <td data-label="Teaching weeks"><WeeksLabel mask={weeksOf(c.optionId)} breakAfterWeek={term.breakAfterWeek} /></td>
                              <td data-label="Seats left"><SeatsMeter capacity={catalog.options.get(c.optionId)?.capacity ?? null} left={c.seatsLeft} /></td>
                              <td class="actions" data-label="Action">
                                {usable(c) ? (
                                  <form method="post" action="/api/move">
                                    <input type="hidden" name="moves" value={moves(c.optionId)} />
                                    {draft && <input type="hidden" name="draftId" value={draft.id} />}
                                    <input type="hidden" name="next" value={`/course/${course.code}/`} />
                                    <button class="btn btn-primary" type="submit">Move {optionName(catalog, b.currentOptionId)} to {optionName(catalog, c.optionId)}, take {nameA}</button>
                                  </form>
                                ) : (
                                  <>
                                    <button class="btn" type="button" disabled>Unavailable</button>
                                    {why(c).map((w) => <div class="why"><StateChip kind={w.kind} /> {w.text}</div>)}
                                  </>
                                )}
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}
                </div>
              );
            })}
          </section>

          <div class="anyway">
            <form method="post" action="/api/select">
              <input type="hidden" name="optionId" value={optionId} />
              <input type="hidden" name="force" value="1" />
              {draft && <input type="hidden" name="draftId" value={draft.id} />}
              <input type="hidden" name="next" value={`/course/${course.code}/`} />
              <button class="btn-link" type="submit">Select anyway (keep the clash)</button>
              <span class="muted"> The clash stays on your timetable and will show as unresolved.</span>
            </form>
          </div>
        </>
      )
    }
  </div>
</section>
