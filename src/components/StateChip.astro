---
// Status = text + icon shape, never colour alone.
type Kind = "yours" | "select" | "full" | "clash" | "overflow" | "dropin" | "draft" | "ok";
interface Props {
  kind: Kind;
  label?: string;
}
const { kind, label } = Astro.props;
const text: Record<Kind, string> = {
  yours: "Yours",
  select: "Select",
  full: "Full",
  clash: "Clash",
  overflow: "Overflow / virtual",
  dropin: "Drop-in",
  draft: "Draft",
  ok: "No clash",
};
---

<span class={`chip chip-${kind}`}>
  <svg class="ico" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
    {kind === "yours" && <><rect x="0.5" y="0.5" width="11" height="11" fill="currentColor" /><path d="M2.8 6.3 5 8.5 9.2 3.6" fill="none" stroke="var(--chip-bg)" stroke-width="1.8" /></>}
    {kind === "ok" && <path d="M2 6.5 5 9.5 10.5 3" fill="none" stroke="currentColor" stroke-width="2" />}
    {kind === "select" && <><rect x="1" y="1" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M4.5 3.5 8 6l-3.5 2.5z" fill="currentColor" /></>}
    {kind === "full" && <><rect x="0.75" y="0.75" width="10.5" height="10.5" fill="none" stroke="currentColor" stroke-width="1.5" /><rect x="2.5" y="5" width="7" height="2.2" fill="currentColor" /></>}
    {kind === "clash" && <><path d="M6 1 11.5 11h-11z" fill="currentColor" /><path d="M6 4.6v3M6 9v.01" stroke="var(--chip-bg)" stroke-width="1.4" /></>}
    {kind === "overflow" && <path d="M6 .8 11.2 6 6 11.2.8 6z" fill="none" stroke="currentColor" stroke-width="1.5" />}
    {kind === "dropin" && <circle cx="6" cy="6" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 1.4" />}
    {kind === "draft" && <path d="M1.5 10.5 2 7.5 8 1.5l2.5 2.5-6 6z" fill="none" stroke="currentColor" stroke-width="1.3" />}
  </svg>
  <span>{label ?? text[kind]}</span>
</span>
