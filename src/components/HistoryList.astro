---
// Changes newest first; each line "COMP3900 tutorial: Wed 2–3:30pm → Wed 4–5:30pm". Undo on the newest undoable one.
import type { Catalog } from "../lib/engine/types";
import type { HistoryBatch } from "../lib/services/alloc";
import Icon from "./Icon.astro";
import { fmtWhen, groupLabel, optionCode, sourceWords } from "./h-format";

interface Props {
  batches: HistoryBatch[];
  catalog: Catalog;
}
const { batches, catalog } = Astro.props;
---

{
  batches.length === 0 ? (
    <div class="block">
      <h2>No changes yet</h2>
      <p>When you change a class it shows up here.</p>
    </div>
  ) : (
    <ol class="batches" aria-label="Changes, newest first">
      {batches.map((b) => (
        <li class:list={["batch", { undone: b.undoneByBatchId !== null }]} id={`b-${b.batchId}`}>
          <div class="batch-head">
            <strong>{sourceWords(b.source)}</strong>
            <span class="when">{fmtWhen(b.createdAt)}</span>
            {b.undoneByBatchId !== null && <span class="chip">Undone</span>}
            {b.undoable && (
              <form method="post" action="/api/undo">
                <input type="hidden" name="batchId" value={b.batchId} />
                <input type="hidden" name="next" value="/history/" />
                <button class="btn small" type="submit"><Icon name="undo" />Undo</button>
              </form>
            )}
          </div>
          <ul>
            {b.entries.map((e) => (
              <li>
                {groupLabel(catalog, e.groupId)}: {optionCode(catalog, e.fromOptionId, "not enrolled")} → {optionCode(catalog, e.toOptionId, "dropped")}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  )
}
