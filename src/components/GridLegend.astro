---
import GridIcon from "./GridIcon.astro";
const items = [
  { kind: "yours", tag: "Yours", text: "The time you hold (solid border)." },
  { kind: "option", tag: "Option", text: "Another time for the class (double border)." },
  { kind: "collides", tag: "Collides", text: "A class that overlaps (thick red border)." },
  { kind: "ghost", tag: "Ghost", text: "Your other classes, for context (dotted)." },
  { kind: "dropin", tag: "Drop-in", text: "Optional drop-in, never clashes (dashed)." },
] as const;
---

<section class="grid-legend" aria-labelledby="legend-h">
  <h2 id="legend-h">Legend</h2>
  <ul>
    {
      items.map((i) => (
        <li>
          <span class={`lg-swatch gblk--${i.kind}`}>
            <GridIcon kind={i.kind} /> {i.tag}
          </span>
          <span>{i.text}</span>
        </li>
      ))
    }
  </ul>
  <p class="grid-note">“Full” is written on times with no seats left.</p>
</section>
