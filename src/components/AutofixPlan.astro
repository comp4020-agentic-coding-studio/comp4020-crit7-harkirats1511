---
// Renders an autofixPreview: clean / solved (move plan + confirm) / unsolved (why, per clash).
import { allClashes, clashesFor } from "../lib/engine/clash";
import { scorePrefs } from "../lib/engine/prefs";
import { autofix } from "../lib/engine/solve";
import type { Allocation, Catalog, Prefs, SeatsUsed, Term } from "../lib/engine/types";
import type { AutofixPreview } from "../lib/services/alloc";
import { courseHref, groupLabel, optionCode, overlapWords, plural } from "./h-format";

interface Props {
  preview: AutofixPreview;
  catalog: Catalog;
  term: Term;
  real: Allocation;
  seats: SeatsUsed;
  prefs: Prefs;
}
const { preview, catalog, term, real, seats, prefs } = Astro.props;
const r = preview.result;
const clashes = allClashes(real, catalog);
const before = scorePrefs(real, catalog, prefs);
const after = r.score;

const isFull = (id: string) => {
  const o = catalog.options.get(id)!;
  return o.capacity !== null && (seats.get(id) ?? 0) >= o.capacity;
};
// Why a clashing class cannot move, in one sentence.
function why(groupId: string): string {
  const g = catalog.groups.get(groupId)!;
  const cur = real.get(groupId);
  const others = g.options.filter((o) => o.id !== cur && !o.overflow);
  const name = groupLabel(catalog, groupId);
  if (others.length === 0) return `Your ${name} runs once.`;
  if (others.every((o) => isFull(o.id))) return `Every other time for your ${name} is full.`;
  if (others.every((o) => isFull(o.id) || clashesFor(o.id, real, catalog).length > 0)) return `Every other time for your ${name} is full or overlaps another class.`;
  return `Your ${name} has free times, but no set of moves clears every clash at once.`;
}
const immovable = (gid: string) => catalog.groups.get(gid)!.options.every((o) => o.id === real.get(gid) || o.overflow);
const stuck = clashes.filter((c) => immovable(c.groupA) && immovable(c.groupB));
const stuckGroups = new Set(stuck.flatMap((c) => [c.groupA, c.groupB]));
const rest = clashes.filter((c) => !stuck.includes(c));
let partial: ReturnType<typeof autofix> | null = null;
if (!r.solved && !r.alreadyClean && stuck.length > 0 && rest.length > 0) {
  const without = new Map([...real].filter(([g]) => !stuckGroups.has(g)));
  const p = autofix(without, catalog, seats, prefs);
  if (p.solved && !p.alreadyClean) partial = p;
}
---

{
  r.alreadyClean ? (
    <section class="block good" aria-labelledby="af-h">
      <h2 id="af-h">Nothing to fix</h2>
      <p>No clashes in your timetable.</p>
    </section>
  ) : r.solved ? (
    <div class="stack">
      <section class="block" aria-labelledby="af-h">
        <h2 id="af-h">Fix found: {plural(r.moves.length, "move")}</h2>
        <p>
          The fewest moves that clear every clash{r.capped ? " the search could check" : ""}. Ties go to your <a href="/preferences/">preferences</a>. Nothing changes until you confirm.
        </p>
        <div class="table-wrap" style="margin-top:12px">
          <table class="data stackable">
            <caption class="sr">Moves</caption>
            <thead>
              <tr><th scope="col">Class</th><th scope="col">From</th><th scope="col">To</th></tr>
            </thead>
            <tbody>
              {r.moves.map((m) => (
                <tr>
                  <th scope="row">{groupLabel(catalog, m.groupId)}</th>
                  <td>{optionCode(catalog, m.fromOptionId, "Not enrolled")}</td>
                  <td>{optionCode(catalog, m.toOptionId, "Dropped")}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>Preference score: {before.total} now, {after ? after.total : "n/a"} after (lower is better).</p>
      </section>
      <form method="post" action="/api/autofix" class="row">
        <input type="hidden" name="basis" value={preview.basis} />
        <button class="btn solid" type="submit">Apply {plural(r.moves.length, "move")}</button>
        <span class="muted">You can undo it straight after.</span>
      </form>
    </div>
  ) : (
    <div class="stack">
      <section class="block warn" aria-labelledby="af-h">
        <h2 id="af-h">No fix clears every clash</h2>
        <p>Auto-fix tried every set of moves{r.capped ? " it could" : ""} with the seats open right now.</p>
      </section>
      {clashes.map((c) => (
        <section class="block" aria-label={`${groupLabel(catalog, c.groupA)} and ${groupLabel(catalog, c.groupB)}`}>
          <h2>{groupLabel(catalog, c.groupA)} and {groupLabel(catalog, c.groupB)}</h2>
          <p>Overlap: {overlapWords(term, c).join("; ")}.</p>
          <ul class="bul">
            <li>{why(c.groupA)}</li>
            <li>{why(c.groupB)}</li>
          </ul>
        </section>
      ))}
      {partial && (
        <section class="block" aria-labelledby="af-part">
          <h2 id="af-part">The other {plural(rest.length, "clash", "clashes")} can be fixed</h2>
          <ul class="bul">
            {partial.moves.map((m) => (
              <li>
                <a href={courseHref(catalog, m.groupId)}>{groupLabel(catalog, m.groupId)}</a>: {optionCode(catalog, m.fromOptionId, "not enrolled")} → {optionCode(catalog, m.toOptionId, "dropped")}
              </li>
            ))}
          </ul>
        </section>
      )}
      <p class="muted">A class that runs once can’t move. Ask the convenor whether lectures are recorded.</p>
    </div>
  )
}
